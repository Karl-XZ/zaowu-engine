# ============================================================
# 造物引擎 配置文件：复制为 .env 后填写。
# 任何第三方密钥留空 = 该能力自动进入【模拟模式】，整条流程仍可跑通。
# ============================================================

# ---- 基础 ----
SECRET_KEY=请改成一串随机长字符串
# 默认 SQLite；生产建议 PostgreSQL：postgresql+psycopg://user:pass@host:5432/zaowu
DATABASE_URL=
STORAGE_DIR=
PUBLIC_BASE_URL=http://localhost:8010
FRONTEND_ORIGIN=http://localhost:5173
# 注册时这些邮箱自动成为管理员（逗号分隔）
ADMIN_EMAILS=admin@zaowu.local

# ---- 计次规则（PRD §5，默认值即 PRD V1.4）----
DAILY_FREE_QUOTA=3
PAID_PRICE_FEN=500
DESIGN_TURNS_LIMIT=10
DAILY_FAILED_ATTEMPTS_LIMIT=5
DAILY_FAILED_COST_LIMIT_FEN=200
DAILY_ABANDONED_SESSIONS_LIMIT=3
SESSION_EXPIRE_HOURS=24
PLATFORM_DAILY_FREE_BUDGET_FEN=20000

# ---- 成本估算（拿到真实账单后修改；未知成本不得视为 0）----
COST_CONCEPT_IMAGE_FEN=10
COST_LUX3D_FEN=100
SESSION_BUDGET_FEN=350

# ---- 效果图生成（供应商待定）→ backend/app/providers/image.py ----
IMAGE_PROVIDER=
IMAGE_API_BASE=
IMAGE_API_KEY=

# ---- Aholo Lux3D（中国区 Key 从 labs.aholo3d.cn 获取，与国际区不互通）→ backend/app/providers/aholo.py ----
AHOLO_REGION=cn
AHOLO_API_BASE=
AHOLO_API_KEY=
AHOLO_MODEL_VERSION=G1

# ---- 支付宝 Vibe Pay → backend/app/providers/alipay.py ----
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://你的域名/api/v1/pay/webhook

# ---- 嘉立创开放平台（3D 打印权限需人工审核）→ backend/app/providers/jlc.py ----
JLC_API_BASE=
JLC_APP_KEY=
JLC_APP_SECRET=
JLC_UPLOAD_URL=https://www.jlc-3dp.cn/

# ---- 切片器 CLI（OrcaSlicer / PrusaSlicer），留空则用几何估算 ----
SLICER_CLI_PATH=

# Natural-language design interpretation (optional; no key keeps local rules)
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
COST_SEMANTIC_FEN=2

# Require a live regional credit quote before every real Aholo create
AHOLO_QUOTE_ENABLED=true
AHOLO_MAX_CALL_CREDITS=64

# CAD geometry code uses a separate reasoning model
DEEPSEEK_CAD_MODEL=deepseek-flash
COST_CAD_AI_FEN=5
CAD_AI_JOB_BUDGET_FEN=30
CAD_AI_MAX_ATTEMPTS=3
GENERATION_WORKERS=2
CAD_SCRIPT_TIMEOUT_S=60
DAILY_CAD_AI_PLAN_LIMIT=50
